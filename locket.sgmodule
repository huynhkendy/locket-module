#!name=locketnghuynh
#!desc=Mở khóa Locket Gold VIP vĩnh viễn, video dài 45s, 37 bộ lọc Photobooth độc quyền và thông báo chống scam By Trượng Ngọc Huỳnh (Zalo: 0355251774).
#!author=Trượng Ngọc Huỳnh
#!category=Locket
#!system=iOS
#!update-url=https://raw.githubusercontent.com/huynhkendy/locket-module/main/locket.sgmodule

[Script]
# 1. Mở khóa RevenueCat Gold VIP (Response)
locketnghuynh_RC = type=http-response,pattern=^https?:\/\/(api|rc-backup)\.revenuecat\.com\/v1\/(subscribers|receipts).*,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/huynhkendy/locket-module/main/locket.js

# 2. Firebase Remote Config 45s + Mic + Audio + Thẻ Gold + Khung + Popup Chống Scam (Response)
locketnghuynh_Firebase = type=http-response,pattern=^https?:\/\/firebaseremoteconfig(realtime)?\.googleapis\.com\/.*,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/huynhkendy/locket-module/main/locket.js

# 3. Xử lý toàn bộ Cloud Functions & Filter AI qua Server (Request) - Đồng bộ 100% với DNS
locketnghuynh_AI = type=http-request,pattern=^https?:\/\/us-central1-locket-4252a\.cloudfunctions\.net\/.*,requires-body=1,binary-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/huynhkendy/locket-module/main/locket.js

[Header Rewrite]
# Chống cache 304 Not Modified để luôn nhận dữ liệu mới và kích hoạt Gold
^https?:\/\/(api|rc-backup)\.revenuecat\.com\/v1\/(subscribers|receipts).* header-del X-RevenueCat-ETag
^https?:\/\/(api|rc-backup)\.revenuecat\.com\/v1\/(subscribers|receipts).* header-del If-None-Match

[MITM]
hostname = %APPEND% api.revenuecat.com, *.revenuecat.com, rc-backup.revenuecat.com, firebaseremoteconfigrealtime.googleapis.com, firebaserecoanfig.googleapis.com, us-central1-locket-4252a.cloudfunctions.net
